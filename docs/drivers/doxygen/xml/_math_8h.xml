        <type>uint16_t</type>
        <definition>uint16_t Math_avgBestOfThreeValues</definition>
        <argsstring>(uint16_t arr[])</argsstring>
        <name>Math_avgBestOfThreeValues</name>
        <param>
          <type>uint16_t</type>
          <declname>arr</declname>
          <array>[]</array>
        </param>
        <briefdescription>
<para>Function to average the best of three values. </para>        </briefdescription>
        <detaileddescription>
<para>The value with the highest deviation will be discarded and the average of the two remaining values will be returned.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">arr</parametername>
</parameternamelist>
<parameterdescription>
<para>array with 3 uint16_t elements</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Returns the average value </para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="source/ti/drivers/utils/Math.h" line="117" column="1"/>
      </memberdef>
      <memberdef kind="function" id="_math_8h_1ae4dd384f2006fccd7cee2da7f5a7a095" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>uint16_t</type>
        <definition>uint16_t Math_calcAverage</definition>
        <argsstring>(uint16_t arr[], uint_fast16_t size)</argsstring>
        <name>Math_calcAverage</name>
        <param>
          <type>uint16_t</type>
          <declname>arr</declname>
          <array>[]</array>
        </param>
        <param>
          <type>uint_fast16_t</type>
          <declname>size</declname>
        </param>
        <briefdescription>
<para>Function to calculate the average of an array of numbers. </para>        </briefdescription>
        <detaileddescription>
<para>The function takes an uint16 array and its size as input. It iterates through the array, summing its elements. Then calculates the average.</para><para><simplesect kind="note"><para>The maximum size of the array is 65537.</para></simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">arr</parametername>
</parameternamelist>
<parameterdescription>
<para>Array with <computeroutput>size</computeroutput> uint16_t elements </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">size</parametername>
</parameternamelist>
<parameterdescription>
<para>The size of the array</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Returns the average value </para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
